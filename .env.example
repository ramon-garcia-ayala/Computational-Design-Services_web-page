# Secret used to sign the access cookies for client proposals.
# Minimum 16 characters. Generate one with:  openssl rand -hex 32
#
# Without this variable, protected proposals stay locked for everyone in
# production (fails closed). In development a fixed value is used.
#
# Local:      copy this file to .env.local and fill it in
# Production: vercel env add PROPOSAL_SECRET
PROPOSAL_SECRET=

# Secret used to sign the magic-link and session tokens for the client
# portal (/portal). Minimum 16 characters. Generate one with:
#
#     openssl rand -hex 32
#
# Deliberately separate from PROPOSAL_SECRET — rotating one should not
# silently invalidate the other's sessions. Without this variable, the portal
# stays locked for everyone in production (fails closed). In development a
# fixed value is used. Changing it invalidates every session already issued,
# so redeploy right after.
#
# Local:      copy this file to .env.local and fill it in
# Production: vercel env add PORTAL_SECRET   (then redeploy — environment
#             variables do not apply to deployments that already exist)
PORTAL_SECRET=

# Anthropic key for the hero assistant and the mini tools it generates.
# Server-side only — never prefix it with NEXT_PUBLIC_.
#
# Without it /api/minitools-chat answers 503 and the chat says it is offline
# (fails closed). There is no development fallback.
#
# Local:      copy this file to .env.local and fill it in
# Production: vercel env add ANTHROPIC_API_KEY   (then redeploy — environment
#             variables do not apply to deployments that already exist)
ANTHROPIC_API_KEY=

# Resend API key for the contact form (/api/contact).
# Server-side only — never prefix it with NEXT_PUBLIC_.
#
# Without it the route answers 503 and the form says it cannot send (fails
# closed), so a submission is never silently dropped.
#
# Local:      copy this file to .env.local and fill it in
# Production: vercel env add RESEND_API_KEY   (then redeploy — environment
#             variables do not apply to deployments that already exist)
RESEND_API_KEY=

# Who the contact form mails, comma-separated. Falls back to
# `contactRecipients` in src/data/site.ts when unset, which is
# info@r-xtech.com — so in production this normally stays empty and the
# address lives in the data layer with the rest of the copy. Set it only to
# route somewhere else without a deploy.
#
# Until the domain is verified (see CONTACT_FROM), Resend only delivers to
# the address that owns the account, so during that window this has to be
# that address for anything to arrive at all.
CONTACT_TO=

# The address BOTH transactional senders send FROM: the contact form
# (/api/contact) and the client portal's magic link
# (/api/portal/request-link). One variable, two routes — a wrong value here
# breaks sign-in, not just the contact form, so change it knowing that.
#
# Unset, it falls back to onboarding@resend.dev, Resend's sandbox sender.
# That works, but it is the wrong domain on every mail a client receives and
# a good share of them land in spam, so it is a launch blocker rather than a
# nice-to-have.
#
# To send as r-xtech.com:
#
#   1. Resend dashboard -> Domains -> Add domain -> r-xtech.com
#   2. Add the DKIM/SPF records it gives you to the r-xtech.com DNS zone
#      (the same registrar the site's own domain is served from), then press
#      Verify. Propagation is usually minutes, occasionally hours.
#   3. Only once it reads "Verified", set this to an address on that domain.
#
# Use a send-only mailbox, not the inbox the form delivers to: replies are
# already handled by the route's `replyTo`, which points at the visitor who
# wrote in, so nothing needs to arrive at this address.
#
#   CONTACT_FROM="R²XTECH <no-reply@r-xtech.com>"
#
# Production: vercel env add CONTACT_FROM   (then redeploy — environment
#             variables do not apply to deployments that already exist)
CONTACT_FROM=

# ---------------------------------------------------------------------------
# DEV_ONLY — hosts allowed to pull `/_next/*` dev resources
# ---------------------------------------------------------------------------
# Only needed to open the dev server from another device, which is the one way
# this project's mobile layout can actually be checked. `next dev` refuses
# `/_next/*` to any origin but localhost, and the refusal is silent where it
# matters: the page returns 200 and the HTML renders, but `/_next/webpack-hmr`
# is blocked, the dev runtime never finishes hydrating, and no client effect
# ever runs. Home then shows a black screen (`Preloader` is server-rendered as
# a full-viewport carbon plate and only its own effect removes it) and the
# portal shows its chrome with no content (`Reveal` holds everything at
# `opacity: 0` until GSAP settles it). The only clue is a warning in the dev
# server's own log.
#
# `next.config.ts` already defaults to the private IPv4 ranges, so the usual
# case needs nothing here. Set this only to narrow or extend that list.
# Ignored by `next build`.
#
#   DEV_ORIGINS="192.168.1.42,my-laptop.local"
DEV_ORIGINS=
