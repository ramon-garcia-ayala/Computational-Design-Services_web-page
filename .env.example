# Secreto con el que se firman las cookies de acceso a las propuestas de cliente.
# Mínimo 16 caracteres. Generar uno con:  openssl rand -hex 32
#
# Sin esta variable, en producción las propuestas protegidas quedan cerradas
# para todo el mundo (falla en seguro). En desarrollo se usa un valor fijo.
#
# Local:      copiar este archivo a .env.local y rellenarlo
# Producción: vercel env add PROPOSAL_SECRET
PROPOSAL_SECRET=
